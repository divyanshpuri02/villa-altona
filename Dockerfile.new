# Use a more reliable Debian-based Node image
FROM node:18-slim

WORKDIR /app

# Install build dependencies
COPY package*.json ./
RUN npm install

# Copy source and build
COPY . .
RUN npm run build

# Set production environment and port
ENV NODE_ENV=production
ENV PORT=8080
EXPOSE 8080

# Use the express server for reliability
CMD ["node", "server-express.js"]